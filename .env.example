# GEMINI_API_KEY: Primary cloud text model (optional).
# OLLAMA_BASE_URL / OLLAMA_MODEL / OLLAMA_API_KEY: fallback text model.
#   Accepts either wire format:
#     - Ollama native:       http://192.168.1.50:11434
#     - OpenAI-compatible:   http://192.168.1.50:11434/v1   (llama.cpp, LiteLLM, Ollama Cloud)
#   Ollama Cloud (https://ollama.com) requires OLLAMA_API_KEY; a local server does not.
# AI_GATEWAY_API_KEY: Vercel AI Gateway / TypeSafe credential for Jev decisions.
# JEV_LOCAL_BASE_URL / JEV_LOCAL_MODEL: keyless local Jev tier (fleet fallback).
#   Android emulator host loopback is 10.0.2.2; a physical device needs the LAN IP.
# All values are injected into BuildConfig at build time. A placeholder disables that provider.
GEMINI_API_KEY=MY_GEMINI_API_KEY
OLLAMA_BASE_URL=MY_OLLAMA_BASE_URL
OLLAMA_MODEL=minicpm5-fable
OLLAMA_API_KEY=MY_OLLAMA_API_KEY
AI_GATEWAY_API_KEY=MY_AI_GATEWAY_API_KEY
AI_GATEWAY_TEXT_MODEL=openai/gpt-4o-mini
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
TYPESAFE_MODEL=typesafe-ai/jev
JEV_LOCAL_BASE_URL=MY_JEV_LOCAL_BASE_URL
JEV_LOCAL_MODEL=jev-latest
